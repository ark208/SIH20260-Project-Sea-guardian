# Sea Guardian Environment Configuration Template
# Copy this file to '.env' and fill in your credentials.

# Server Configuration
PORT=8080
HOST=0.0.0.0
DEBUG=False

# Maritime LLM Analyst (Groq API Key)
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model Weights & Data Paths
SAR_WEIGHTS_PATH=weights/best_deeplabv3.pth
AIS_DATA_PATH=data/
